# Copy to homelab.yml and fill in for your own network.
# The real file is gitignored: it names this machine's tailnet address, the Cloudflare
# tunnel it runs, and the LAN layout — none of it secret, none of it worth publishing.
# The machine is donnager. pemily-homelab is the family cluster (and its repo), not a host.
host_name: donnager
homelab_home: /home/pemily

# Cloudflare tunnel (credentials JSON stays on the host, never in git)
cloudflared_tunnel_name: pemily-home
cloudflared_tunnel_id: 00000000-0000-0000-0000-000000000000

# Klipper printer on the LAN, exposed to the tailnet by printer-forward
printer_lan_ip: 192.168.1.50        # Klipper host on the LAN

# LVM layout — see vault note "Storage layout". Existing root LV is never touched.
lvm_vg: ubuntu-vg
lvm_volumes:
  - { name: k3s-family,     size: 100g, mount: /var/lib/rancher/k3s/storage }
  - { name: immich-library, size: 350g, mount: /srv/immich/library }
  - { name: immich-backups, size: 250g, mount: /srv/backups/immich }
  - { name: incus,          size: 100g }   # raw: Incus formats it as the btrfs pool for VMs

# Family cluster (pemily-homelab) — k3s on the host, not built yet. Version pin lives in roles/k3s/defaults.
k3s_cluster_name: pemily-homelab
k3s_tls_san: [donnager, "{{ tailnet_ip }}"]

# Incus — VMs for the seanpe-homelab (personal) cluster. See roles/incus.
incus_bridge_cidr: 10.77.0.1/24
incus_pool_device: /dev/ubuntu-vg/incus
incus_vm_ssh_key: "{{ lookup('ansible.builtin.file', lookup('ansible.builtin.env', 'HOME') ~ '/.ssh/id_ed25519.pub') }}"
incus_vms:
  - { name: seanpe-homelab-1, image: "images:ubuntu/24.04/cloud", ipv4: 10.77.0.10, cpu: 4, memory: 8GiB, disk: 60GiB }
