config:
  limits.cpu: "{{ item.cpu }}"
  limits.memory: "{{ item.memory }}"
  boot.autostart: "true"            # back after a donnager reboot with no manual steps
  cloud-init.user-data: |
    #cloud-config
    packages: [openssh-server]
    users:
      - name: ubuntu
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          - {{ incus_vm_ssh_key }}
devices:
  root: { type: disk, path: /, pool: default, size: "{{ item.disk }}" }
  eth0: { type: nic, name: eth0, network: incusbr0, ipv4.address: "{{ item.ipv4 }}" }
