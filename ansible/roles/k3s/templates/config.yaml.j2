# Managed by pemily-homelab/ansible — k3s server for the {{ k3s_cluster_name }} cluster.
write-kubeconfig-mode: "0600"
{% if k3s_tls_san | length > 0 %}
tls-san:
{% for san in k3s_tls_san %}
  - {{ san }}
{% endfor %}
{% endif %}
# Ingress comes from cloudflared routing straight to Services; nothing uses Traefik.
disable:
  - traefik
